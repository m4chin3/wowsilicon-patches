diff --git a/rosetta_core/src/AssemblerHelpers.cpp b/rosetta_core/src/AssemblerHelpers.cpp
index 6012685..a1a1d76 100644
--- a/rosetta_core/src/AssemblerHelpers.cpp
+++ b/rosetta_core/src/AssemblerHelpers.cpp
@@ -837,4 +837,19 @@ auto emit_ldrs(AssemblerBuffer& insn_buf, int is_64bit, unsigned int size, int d
     emit_ldr_str_imm(insn_buf, static_cast<int>(size),
                      /*is_fp=*/0, opc,
                      /*imm12=*/0, addr_gpr, dst_gpr);
-}
\ No newline at end of file
+}
+// FMOV (immediate) is valid ARM64, but the installed libRosettaRuntime's
+// state-recovery decoder does not recognize it. Inline literal data is also
+// unsafe for a decoder that scans the generated instruction stream linearly.
+// The caller supplies an allocated scratch GPR; no guest register is clobbered.
+auto emit_f64_bits(AssemblerBuffer& buf, int Dd, uint64_t bits, int scratch_gpr) -> void {
+    bool initialized = false;
+    for (int hw = 3; hw >= 0; --hw) {
+        const auto part = static_cast<uint16_t>(bits >> (16 * hw));
+        if (!part && initialized) continue;
+        if (!part && hw != 0) continue;
+        emit_movn(buf, 1, initialized ? 3 : 2, hw, part, scratch_gpr);
+        initialized = true;
+    }
+    emit_fmov_x_to_d(buf, Dd, scratch_gpr);
+}
